# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Config with real secrets
phone-agent/config.yaml
.env
*.pem
*.key

# Calibration images (device-specific and potentially contain member data)
phone-agent/calibration/*.png
phone-agent/calibration/*.jpg
phone-agent/calibration/*.jpeg

# Debug screenshots (device/account data, transient)
phone-agent/grabs/
phone-agent/shots/

# Local SQLite state is not source code; use managed Postgres in production
webapp/data/*.db*

# Evidence / downloads
downloads/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Logs
*.log
nohup.out

# Node / webapp
node_modules/
.next/
webapp/.env.local
